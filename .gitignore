# ─────────────────────────────────────────────────────────────────────────────
# Jarvis — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
*.egg
dist/
build/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Local data (notes, tasks, memories — personal, not for version control) ───
data/
*.db
*.db-shm
*.db-wal

# ── Environment variables (may contain secrets) ───────────────────────────────
.env

# ── Testing & coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ── IDE / editors ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── uv ────────────────────────────────────────────────────────────────────────
.uv/
uv.lock

# ── Gradio temp files ─────────────────────────────────────────────────────────
gradio_cached_examples/
flagged/
