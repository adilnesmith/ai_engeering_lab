# ─────────────────────────────────────────────────────────────────────────────
# Jarvis — Environment Configuration
# Copy this file to .env and edit the values as needed.
#   cp .env.example .env
#
# None of these are required — Jarvis ships with sensible defaults for local use.
# ─────────────────────────────────────────────────────────────────────────────

# Ollama server URL
# Default: http://localhost:11434
# Change this if you're running Ollama on a different machine or port.
OLLAMA_BASE_URL=http://localhost:11434

# Chat model to use via Ollama
# Default: llama3.2:3b  (best CPU-friendly model with reliable tool-calling)
# Alternatives: qwen2.5:3b, phi3:mini, mistral:7b (needs more RAM)
# Make sure to run: ollama pull <MODEL_NAME> before changing this.
MODEL_NAME=llama3.2:3b

# Embedding model for long-term and episodic memory (vector search)
# Default: nomic-embed-text  (a dedicated embedding model, separate from the chat model)
# Run: ollama pull nomic-embed-text
EMBED_MODEL=nomic-embed-text

# Path to the SQLite database file (stores notes and tasks)
# Default: ./data/jarvis.db
DB_PATH=./data/jarvis.db

# Path to the Chroma vector store directory (stores long-term and episodic memories)
# Default: ./data/chroma_db
CHROMA_PATH=./data/chroma_db

# Number of messages before conversation compression kicks in (episodic memory)
# Default: 20
COMPRESSION_THRESHOLD=20
